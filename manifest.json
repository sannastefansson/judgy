{
  "manifest_version": 3,
  "name": "Judgy Sanna",
  "version": "0.1.0",
  "description": "Judges your time-wasting, cheers your real work. All data stays on your device. Zero network requests.",
  "permissions": ["storage", "idle", "tabs", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["defaults.js", "messages.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["widget.css", "icons/face.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
